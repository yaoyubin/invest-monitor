# 投资日报 - 环境变量配置示例
#
# 使用方法：
# 1. 复制此文件为 .env：cp .env.example .env (Linux/Mac) 或 copy .env.example .env (Windows)
# 2. 编辑 .env 文件，填入你的实际配置值
# 3. .env 已被 .gitignore 忽略，不会被提交到仓库

# Gmail 邮件通知配置（必需）
GMAIL_SENDER=yourname@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
GMAIL_RECIPIENT=recipient@example.com

# Finnhub API（可选，用于高管买卖；未配置则不抓取）
# 免费注册：https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key

# 投资雷达 LLM 评分（可选；未配置则跳过评分，所有信息默认 B 级）
# 默认 provider=openai，可选 anthropic / deepseek / gemini / siliconflow / azure
SCORER_LLM_PROVIDER=openai
# SCORER_LLM_MODEL=gpt-4o-mini       # openai
# SCORER_LLM_MODEL=claude-sonnet-4-6 # anthropic
OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=

# 调试：设了就把每次 LLM 调用的 prompt/response/parsed 落盘到该目录
# SCORER_DEBUG_DIR=./scorer_debug

# 雪球大V长文抓取（可选；invest/xueqiu.py，需 Playwright + 已登录的 chrome_profile/）
# ENABLE_XUEQIU=1 在 invest_daily.py 里启用；dry_run.py 用 --include-xueqiu CLI 标志
# XUEQIU_DAYS_BACK=7  抓最近 N 天的帖子（默认 7）
# XUEQIU_COOKIE 不再需要 — 走 Playwright 浏览器登录态，不依赖单纯 cookie

# YouTube 财经 UP 主视频总结（invest/youtube.py）
# - 字幕能抓到时：走 SCORER_LLM_PROVIDER（Anthropic）总结
# - 字幕被禁时：fallback 到 Gemini 2.5 Flash 直接读 YouTube URL
# 申请免费 key：https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key
# 可选：覆盖默认模型
# YOUTUBE_GEMINI_MODEL=gemini-2.5-flash

# IC 中证500股指期货年化贴水（invest/ic_basis.py，新浪行情，无需 key）
# 年化口径：calendar = 自然日 ×365（默认），trading = 交易日 ×252（粗略只去周末）
# IC_BASIS_DAY_COUNT=calendar

# 当日板块复盘（invest/sector_moves.py）
# A股板块来自东方财富、美股板块来自一篮子行业/主题 ETF（yfinance），都不需要 key。
# 归因需要 ANTHROPIC_API_KEY（用 Claude 的 web search 检索当日新闻）；没有 key 就只出涨跌表。
# ENABLE_SECTOR_MOVES=0        # 整节关掉
# ENABLE_SECTOR_REASONS=0      # 只要涨跌表，不跑归因（省钱）
# SECTOR_LLM_MODEL=claude-sonnet-5   # 归因模型，默认 Sonnet（不跟随 SCORER_LLM_MODEL）
# SECTOR_MAX_SEARCHES=8        # 每个市场最多搜几次
# SECTOR_MAX_TOKENS=12000      # 给小了模型会把预算全花在搜索上、正文一个字都吐不出来
# SECTOR_CN_MIN_CAP_YI=500     # A股板块最小总市值（亿），滤掉几只票拉涨停的迷你板块
# SECTOR_CN_MIN_MEMBERS=5      # A股板块最小成分股数
# SECTOR_DEBUG_DIR=./sector_debug    # 落盘归因的 prompt/原始回复
