# 投资日报 - 环境变量配置示例
#
# 使用方法：
# 1. 复制此文件为 .env：cp .env.example .env (Linux/Mac) 或 copy .env.example .env (Windows)
# 2. 编辑 .env 文件，填入你的实际配置值
# 3. .env 已被 .gitignore 忽略，不会被提交到仓库

# Gmail 邮件通知配置（必需）
GMAIL_SENDER=yourname@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
GMAIL_RECIPIENT=recipient@example.com

# Finnhub API（可选，用于高管买卖；未配置则不抓取）
# 免费注册：https://finnhub.io
FINNHUB_API_KEY=your_finnhub_api_key

# 投资雷达 LLM 评分（可选；未配置则跳过评分，所有信息默认 B 级）
# 默认 provider=openai，可选 anthropic / deepseek / gemini / siliconflow / azure
SCORER_LLM_PROVIDER=openai
# SCORER_LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
# GOOGLE_API_KEY=
